# Required for daily recommendations. Menu collection works without it.
OPENAI_API_KEY=

# Efficient default for the structured extraction and assessment tasks.
OPENAI_MODEL=gpt-5.6-luna

# Hard request caps. Set either to 0 to block AI calls for that operation.
OPENAI_REFRESH_REQUEST_BUDGET=100
OPENAI_ADMIN_SOURCE_REQUEST_BUDGET=20

# Enables the unlinked /admin panel. Use at least 16 characters.
ADMIN_PASSWORD=

# Use a bare public hostname in production to enable automatic HTTPS.
SITE_ADDRESS=http://localhost
